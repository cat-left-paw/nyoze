# Public repo allowlist. Everything is ignored by default.
*
!/.gitignore
!/package.json
!/index.html
!/package-lock.json
!/tsconfig.json
!/tsconfig.node.json
!/vite.config.ts
!/electron-builder.json5
!/README.md
!/MANUAL.md
!/latest.json
!/scripts/
!/scripts/package-mac-arch.mjs
!/scripts/run-with-clean-electron-env.mjs
!/src/
!/src/**
!/electron/
!/electron/**
!/public/
!/public/**
!/build/
!/build/icons/
!/build/icons/**
!/build/windows/
!/build/windows/README.txt
!/LICENSE
!/NOTICE
!/CHANGELOG.md
!/INSTALL.md
!/RELEASE_NOTES.md

# Deny common local/OS/editor artifacts even under allowed directories.
.DS_Store
**/.DS_Store
._*
**/._*
Thumbs.db
**/Thumbs.db
Desktop.ini
**/Desktop.ini
*.swp
**/*.swp
*.swo
**/*.swo
*~
**/*~
*.code-workspace
**/*.code-workspace
